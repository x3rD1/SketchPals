DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sketch_db"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_CLIENT_ID=

JWT_ACCESS_TOKEN=
JWT_REFRESH_TOKEN=

NODE_ENV="development"

FRONTEND_URL="http://localhost:5173"

# This project uses Cloudinary to handle image and file uploads. Follow these steps to get your API keys:

# 1. Sign up for a free account at [Cloudinary](https://cloudinary.com).
# 2. Log into your account and navigate to your Dashboard (the home icon in the left sidebar).
# 3. Find the Product Environment Credentials section at the top of your dashboard.
# 4. Copy your credentials and add them to in here.

# For Google Client ID just copy the one you have from frontend/.env

# To generate JWT tokens run this once in your terminal per token
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"